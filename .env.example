# Varshyl Hub — Environment Variables
# Copy this to .env for local development

PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://user:password@localhost:5432/varshyl_hub
JWT_SECRET=change-this-to-a-random-string

# Admin access — comma-separated list of admin emails
ADMIN_EMAILS=vaakapila@gmail.com,vagishkapila@gmail.com

# Base URL for links (no trailing slash)
BASE_URL=http://localhost:3000

# Stripe Organization API key (read-only across all product accounts)
# STRIPE_ORG_KEY=rk_live_...

# Product DB connection strings (read-only)
# CONSTRUCTINVOICE_DB_URL=postgresql://...
# DOCUFLOW_DB_URL=postgresql://...
