# ═══════════════════════════════════════════════════════════════════════════
# Varshyl Hub Backend — Environment Variables
# ═══════════════════════════════════════════════════════════════════════════

# Server
PORT=3000
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/varshyl_hub

# Authentication
JWT_SECRET=your-super-secret-jwt-key-min-32-chars

# CORS
ALLOWED_ORIGIN=*

# Admin Emails (comma-separated)
ADMIN_EMAILS=vaakapila@gmail.com

# Stripe (Optional — only needed for Stripe org reporting features)
STRIPE_ORG_KEY=
