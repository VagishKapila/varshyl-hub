{
  "name": "varshyl-hub",
  "version": "2.0.0",
  "description": "Varshyl Business Hub — Super admin dashboard for all Varshyl SaaS products",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node server/index.js",
    "build": "cd client && npm install --omit=dev && npm run build",
    "postinstall": "cd client && npm install --omit=dev && npm run build",
    "lint": "npx eslint server/ reporter-sdk/",
    "lint:client": "cd client && npx eslint src/",
    "lint:all": "npm run lint && npm run lint:client",
    "test": "npx jest",
    "test:client": "cd client && npx vitest run",
    "test:all": "npm test && npm run test:client"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "stripe": "^21.0.0",
    "zod": "^4.3.6"
  },
  "engines": {
    "node": ">=20"
  },
  "jest": {
    "testMatch": [
      "<rootDir>/server/__tests__/**/*.test.js"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/varshyl-hub-reporter/",
      "<rootDir>/client/"
    ]
  },
  "author": "Vagish Kapila <vaakapila@gmail.com>",
  "license": "PRIVATE",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.1.0",
    "globals": "^17.4.0",
    "jest": "^30.3.0",
    "supertest": "^7.2.2"
  }
}
